{
  "name": "tubedrop-promo",
  "private": true,
  "version": "1.0.0",
  "description": "30s LinkedIn promo for tubedrop, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "sfx": "python3 scripts/make_audio.py",
    "render": "remotion render TubedropPromo out/tubedrop-promo.mp4",
    "still": "remotion still TubedropPromo",
    "master": "sh scripts/master.sh",
    "build": "npm run sfx && npm run render && npm run master"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/shapes": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
